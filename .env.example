# Copy this file to ".env" for local development and fill in real values.
# NEVER commit .env. On Render, set these in the service's Environment tab instead.
# Every value below is a placeholder.

# ---- Required in production ---------------------------------------------------

# "production" on Render. Leave unset locally.
NODE_ENV=

# MongoDB Atlas connection string. Locally you may leave this empty: the server then
# uses a temporary in-memory database (data is lost on restart).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/cv-tailor?retryWrites=true&w=majority

# The password you type to sign in to the app. At least 10 characters in production.
APP_PASSWORD=<choose-a-long-passphrase>

# Random secret used to sign session tokens. At least 32 characters in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<48-random-bytes-as-hex>

# ---- AI provider (OpenAI-compatible) --------------------------------------------

# Leave AI_API_KEY empty to run in demo mode (no AI; output is labelled as demo).
AI_API_KEY=<your-provider-api-key>
# Base URL of an OpenAI-compatible API (the server calls <AI_BASE_URL>/chat/completions).
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# A chat model offered by that provider that can return JSON.
AI_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is overloaded or too slow (comma-separated).
AI_FALLBACK_MODELS=
# Optional. Set to "false" only if your provider rejects response_format=json_object.
AI_JSON_MODE=true
# Optional. Leave empty to use the model's default (some models reject custom values).
AI_TEMPERATURE=
# Optional. Milliseconds to wait for the AI provider before giving up.
AI_TIMEOUT_MS=75000

# ---- Optional -------------------------------------------------------------------

# Port to listen on. Render sets this automatically.
PORT=4000

# Only needed if the frontend is hosted on a DIFFERENT origin from this API.
# Comma-separated list of exact origins, e.g. https://my-frontend.onrender.com
CORS_ORIGINS=

# Set to "false" to run this server as an API only (frontend hosted elsewhere).
SERVE_CLIENT=true

# Maximum size of an uploaded CV, in megabytes.
MAX_UPLOAD_MB=10

# ---- Frontend build-time setting (only for split deployments) ----------------------
# Set when building the client if the API lives on another origin, e.g.
# VITE_API_BASE_URL=https://my-api.onrender.com
# Leave unset for the default single-service deployment.
